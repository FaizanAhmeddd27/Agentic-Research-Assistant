# ------------------------------------------------------------------
# Backend environment variables — copy to `.env` for local dev, or set
# these exact names as Environment Variables on Render.
# ------------------------------------------------------------------

# Postgres (Neon). Use the same pooled connection string as local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-neon.tech/neondb?sslmode=require

# Qdrant Cloud
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# LLM providers
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# Web search
TAVILY_API_KEY=your_tavily_api_key

# LangSmith tracing (optional)
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=Derve
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Session token signing secret — MUST be a long random string in production,
# and MUST match between local dev and the deployed backend only if you want
# tokens to transfer (you usually do NOT — use a fresh one per environment).
AUTH_SECRET=replace_with_a_long_random_string

# CORS: comma-separated list of frontend origins allowed to call this backend.
# In production set this to your Vercel URL, e.g.:
#   CORS_ORIGINS=https://your-app.vercel.app
# If empty, localhost dev origins are used.
CORS_ORIGINS=
